generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  name            String?
  phone           String   @unique
  email           String?  @unique
  avatar          String?
  city            String?
  hearAboutUs     String?
  interests       String?
  trustScore      Int      @default(50)
  role            String   @default("USER")
  isVerified      Boolean  @default(false)
  kycStatus       String   @default("NOT_SUBMITTED")
  stripeAccountId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ownedItems      Item[]
  lentRentals     Rental[]   @relation("LenderRentals")
  borrowedRentals Rental[]   @relation("BorrowerRentals")
  reviewsGiven    Review[]   @relation("Reviewer")
  reviewsReceived Review[]   @relation("Reviewee")
  trustEvents     TrustEvent[]
  disputes        Dispute[]  @relation("DisputeRaiser")
  payouts         Payout[]
  subscription    Subscription?
  notifications   Notification[]
  accounts        Account[]
  sessions        Session[]

  @@map("users")
}

model Item {
  id                   String   @id @default(cuid())
  title                String
  description          String
  category             String
  dailyRate            Float
  weeklyRate           Float?
  itemValue            Float
  condition            String   @default("Good")
  images               String   @default("[]")
  location             String
  lat                  Float?
  lng                  Float?
  ownerId              String
  availabilityCalendar String?
  isActive             Boolean  @default(true)
  depositAmount        Float?
  boostExpiresAt       DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id])
  rentals Rental[]

  @@map("items")
}

model Rental {
  id                     String   @id @default(cuid())
  itemId                 String
  borrowerId             String
  lenderId               String
  startDate              DateTime
  endDate                DateTime
  totalDays              Int
  rentalFee              Float
  platformFee            Float
  depositAmount          Float
  protectionFee          Float    @default(0)
  deliveryFee            Float    @default(0)
  taxes                  Float
  totalPaid              Float
  status                 String   @default("PENDING")
  paymentId              String?
  depositStatus          String?
  depositRefundAmount    Float?
  depositDeductionReason String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  item     Item      @relation(fields: [itemId], references: [id])
  borrower User      @relation("BorrowerRentals", fields: [borrowerId], references: [id])
  lender   User      @relation("LenderRentals", fields: [lenderId], references: [id])
  payments Payment[]
  deposits Deposit[]
  disputes Dispute[]
  reviews  Review[]
  payouts  Payout[]

  @@map("rentals")
}

model Payment {
  id                String   @id @default(cuid())
  rentalId          String
  razorpayOrderId   String?
  razorpayPaymentId String?
  amount            Float
  type              String
  status            String   @default("PENDING")
  capturedAt        DateTime?
  createdAt         DateTime @default(now())

  rental Rental @relation(fields: [rentalId], references: [id])

  @@map("payments")
}

model Payout {
  id          String   @id @default(cuid())
  rentalId    String
  lenderId    String
  amount      Float
  platformCut Float
  status      String   @default("PENDING")
  scheduledAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  rental Rental @relation(fields: [rentalId], references: [id])
  lender User   @relation(fields: [lenderId], references: [id])

  @@map("payouts")
}

model Deposit {
  id              String   @id @default(cuid())
  rentalId        String
  amount          Float
  holdType        String
  mandateId       String?
  status          String   @default("HELD")
  deductionAmount Float?
  deductionReason String?
  refundedAt      DateTime?
  createdAt       DateTime @default(now())

  rental Rental @relation(fields: [rentalId], references: [id])

  @@map("deposits")
}

model Dispute {
  id           String   @id @default(cuid())
  rentalId     String
  raisedById   String
  type         String
  status       String   @default("OPEN")
  description  String
  evidenceUrls String   @default("[]")
  adminNotes   String?
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rental  Rental @relation(fields: [rentalId], references: [id])
  raisedBy User   @relation("DisputeRaiser", fields: [raisedById], references: [id])

  @@map("disputes")
}

model Review {
  id         String   @id @default(cuid())
  rentalId   String
  reviewerId String
  revieweeId String
  rating     Int
  comment    String?
  type       String
  createdAt  DateTime @default(now())

  rental   Rental @relation(fields: [rentalId], references: [id])
  reviewer User   @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewee User   @relation("Reviewee", fields: [revieweeId], references: [id])

  @@map("reviews")
}

model TrustEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  delta     Int
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("trust_events")
}

model Subscription {
  id               String   @id @default(cuid())
  userId           String   @unique
  plan             String   @default("FREE")
  status           String   @default("ACTIVE")
  razorpaySubId    String?
  currentPeriodEnd DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  metadata  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model OTP {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("otps")
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
